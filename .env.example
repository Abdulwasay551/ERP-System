# Copy this file to .env and fill in real values. .env is gitignored - never commit real secrets.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
# VERCEL controls IS_PRODUCTION in settings.py - keep False for local dev.
VERCEL=False

# --- Database ---
# Option A: local Postgres for development (recommended default)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=erp_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Option B: Supabase-hosted Postgres (shared/staging) - uncomment and fill in to use instead
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=postgres
# DB_USER=your-supabase-user
# DB_PASSWORD=your-supabase-password
# DB_HOST=your-project.pooler.supabase.com
# DB_PORT=5432

# Option C: SQLite (quick local smoke-testing only)
# USE_SQLITE=True

# --- CORS (for Next.js web frontend, later phase) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- JWT (djangorestframework-simplejwt) ---
# No env vars required by default; lifetimes are configured in settings.py SIMPLE_JWT.
